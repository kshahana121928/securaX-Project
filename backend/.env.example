PORT=5002
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/securax
JWT_SECRET=securax_super_secret_jwt_key_2026_safe_response
JWT_EXPIRES_IN=7d
COOKIE_SECRET=securax_cookie_signing_secret
FRONTEND_URL=http://localhost:5173

# Notification Configuration (Set to true for automatic simulation if external credentials are not supplied)
ENABLE_SIMULATED_NOTIFICATIONS=true

# Email / SMTP Configuration (Optional: Mailtrap, SendGrid, Gmail, etc.)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=demo_user
SMTP_PASS=demo_pass
SMTP_FROM=SecuraX Emergency Alerts <alerts@securax.com>

# SMS Provider Configuration (Optional: Twilio / AWS SNS / Fast2SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Firebase Cloud Messaging for Web Push (Optional)
FCM_SERVER_KEY=
